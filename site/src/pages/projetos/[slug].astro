---
import Pagina from '../../layouts/Pagina.astro';
import { catalogo } from '../../lib/catalogo.js';

export async function getStaticPaths() {
  return catalogo().plugins.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;

const prontas = p.skills.filter((s) => !s.esqueleto);
const principais = prontas.filter((s) => s.invocavelPeloUsuario);
const defundo = prontas.filter((s) => !s.invocavelPeloUsuario);
const pendentes = p.skills.filter((s) => s.esqueleto);
const algumaManual = principais.some((s) => s.manual);

// projeto.md: a primeira seção ("o que é, e quando a ACTA é contratada") abre a página num
// painel. "As etapas do ciclo de vida" fica sempre aberta, porque é o mapa do método. As
// demais entram em acordeão, fechadas.
const [abreProjeto, ...restoProjeto] = p.projeto?.secoes ?? [];
const sempreAberta = (s) => /etapas do ciclo de vida/i.test(s.titulo);
const abertas = restoProjeto.filter(sempreAberta);
const fechadas = restoProjeto.filter((s) => !sempreAberta(s));
const secoesFundamentos = p.fundamentos?.secoes ?? [];

// Na biblioteca de conceitos as referências são o conteúdo: cada uma é uma lente. Os títulos
// entram na página; o texto delas não sai do plugin.
const comLentes = p.tipo === 'biblioteca' ? prontas.filter((s) => s.referencias.length > 0) : [];

const SOBRESCRITO = {
  projeto: 'Tipo de projeto',
  fundacao: 'Fundação',
  biblioteca: 'Biblioteca de conceitos',
  metodo: 'Método transversal',
};
const contagem = (n, um, varios) => `${n} ${n === 1 ? um : varios}`;
---

<Pagina
  titulo={p.titulo}
  tituloAba={`${p.titulo} | ACTA`}
  sobrescrito={SOBRESCRITO[p.tipo]}
  descricao={p.descricao}
  abertura={p.descricao}
  voltar={{ href: '/projetos', rotulo: 'Projetos' }}
>
  <div slot="meta" class="pe" style="margin-top:1.15rem">
    <span class={`etiqueta ${p.status.toLowerCase()}`}>{p.status}</span>
    <span class="etiqueta">v{p.versao}</span>
    <span class="etiqueta">{contagem(p.skills.length, 'skill', 'skills')}</span>
    {p.projeto?.duracao_tipica && <span class="etiqueta">{p.projeto.duracao_tipica}</span>}
  </div>

  <section class="secao instalar" aria-labelledby="instalar">
    <h2 id="instalar">Instalar</h2>
    <div class="comando"><code>{p.instalacao}</code></div>
    {p.requerTodos.length > 0 ? (
      <>
        <p class="requer">
          Requer{' '}
          {p.requerTodos.map((d, i) => (
            <>{i > 0 && ', '}{d.url ? <a href={d.url}><code>{d.nome}</code></a> : <code>{d.nome}</code>}</>
          ))}.
        </p>
        <p>
          O Claude Code instala as dependências declaradas junto com o plugin, então o comando acima
          basta. Se preferir instalar um por vez, ou se alguma dependência falhar, rode nesta ordem:
        </p>
        <details class="sanfona">
          <summary>Instalar um plugin por vez, na ordem</summary>
          <div class="miolo">
            {p.comandosEmOrdem.map((c) => <div class="comando"><code>{c}</code></div>)}
          </div>
        </details>
      </>
    ) : (
      <p>
        Não depende de outro plugin.
        {p.dependentes.length > 0 &&
          ` É requisito de ${contagem(p.dependentes.length, 'plugin', 'plugins')} do catálogo: no Claude Code, ele entra junto quando qualquer um deles é instalado.`}
      </p>
    )}
    <p class="nota">
      Primeira vez? O <a href="/comecar">guia de instalação</a> mostra como registrar o marketplace e
      o caminho pelo Claude Desktop. <a href={p.repositorio}>Ver a pasta no GitHub</a>.
    </p>
  </section>

  {abreProjeto ? (
    <section class="secao">
      <div class="painel">
        {abreProjeto.titulo && <h2 style="margin-top:0">{abreProjeto.titulo}</h2>}
        <div class="prosa" set:html={abreProjeto.html} />
      </div>
    </section>
  ) : (
    <div class="aviso aviso--atencao">
      <p>
        <strong>A página editorial deste projeto ainda não foi escrita.</strong> O que você vê abaixo
        é derivado do plugin: a lista de skills, mas não as etapas, os riscos nem os entregáveis.
      </p>
    </div>
  )}

  {abertas.map((s) => (
    <section class="secao">
      <h2>{s.titulo}</h2>
      <div class="prosa" set:html={s.html} />
    </section>
  ))}

  {fechadas.length > 0 && (
    <section class="secao">
      {fechadas.map((s) => (
        <details class="sanfona">
          <summary>{s.titulo}</summary>
          <div class="miolo"><div class="prosa" set:html={s.html} /></div>
        </details>
      ))}
    </section>
  )}

  <section class="secao">
    <h2>O que vem no plugin</h2>

    {principais.length > 0 && (
      <>
        <p>
          O Claude carrega estas sozinho quando o assunto aparece na conversa. Não é preciso digitar
          nada especial.
          {algumaManual && ' A exceção são as marcadas como manual: só rodam quando você digita o nome delas depois de /.'}
        </p>
        <div class="grade">
          {principais.map((s) => (
            <article class="cartao">
              <h3><a href={s.url}>{s.titulo}</a></h3>
              <p>{s.oQueFaz || s.descricao}</p>
              <div class="pe">
                <code>{s.nome}</code>
                {s.manual && <span class="etiqueta">manual</span>}
              </div>
            </article>
          ))}
        </div>
      </>
    )}

    {comLentes.map((s) => (
      <>
        <h3>As {s.referencias.length} lentes</h3>
        <p>
          Cada lente é um arquivo de referência que a skill <a href={s.url}><code>{s.nome}</code></a>
          carrega só quando a pergunta pede. Aqui ficam os títulos; o texto vem com o plugin.
        </p>
        <ol class="titulos">
          {s.referencias.map((r) => <li><a href={`${s.url}#${r.ancora}`}>{r.titulo}</a></li>)}
        </ol>
      </>
    ))}

    {(defundo.length > 0 || pendentes.length > 0) && (
      <details class="sanfona" style="margin-top:1.25rem">
        <summary>Detalhe técnico: skills fora do menu e etapas ainda não escritas</summary>
        <div class="miolo">
          {defundo.length > 0 && (
            <>
              <h3>Fora do menu de /</h3>
              <p>
                Não aparecem quando você digita <code>/</code>, mas a descrição continua no contexto:
                o Claude as carrega sozinho quando o assunto aparece, e outras skills as puxam quando
                precisam do conceito exato.
              </p>
              <div class="lista lista--titulos">
                {defundo.map((s) => (
                  <a href={s.url}>
                    <span class="nome">{s.titulo}</span>
                    <span class="oque">{s.oQueFaz || s.descricao}</span>
                  </a>
                ))}
              </div>
            </>
          )}
          {pendentes.length > 0 && (
            <>
              <h3>Etapas ainda não escritas</h3>
              <p>Existem como marcador do que falta: a metodologia delas ainda não foi escrita.</p>
              <p class="pe">
                {pendentes.map((s) => (
                  <a href={s.url} class="etiqueta etiqueta--codigo"><code>{s.nome}</code></a>
                ))}
              </p>
            </>
          )}
        </div>
      </details>
    )}
  </section>

  {secoesFundamentos.length > 0 && (
    <section class="secao">
      <span class="sobrescrito">Embasamento teórico</span>
      <h2>De onde vem o método</h2>
      {secoesFundamentos.map((s) => (
        <details class="sanfona">
          <summary>{s.titulo || 'Introdução'}</summary>
          <div class="miolo"><div class="prosa" set:html={s.html} /></div>
        </details>
      ))}
    </section>
  )}
</Pagina>
