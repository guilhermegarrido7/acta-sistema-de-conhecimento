---
import Pagina from '../../layouts/Pagina.astro';
import { catalogo } from '../../lib/catalogo.js';

export async function getStaticPaths() {
  return catalogo().plugins.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const invocaveis = p.skills.filter((s) => s.invocavelPeloUsuario && s.roteavel && !s.esqueleto);
const defundo = p.skills.filter((s) => !s.invocavelPeloUsuario);
const pendentes = p.skills.filter((s) => s.esqueleto || !s.roteavel);
const resumo = (d) => d.split('. Acionar')[0].replace(/\.$/, '') + '.';
const titulo = p.titulo;

// A primeira seção do projeto.md ("o que é, e quando a ACTA é contratada") fica
// sempre visível, num painel de destaque. As demais viram itens de acordeão:
// é o mesmo conteúdo, só que sem despejar tudo como parede de texto.
const [abreProjeto, ...restoProjeto] = p.projeto?.secoes ?? [];
const [abreFundamentos, ...restoFundamentos] = p.fundamentos?.secoes ?? [];
---

<Pagina
  titulo={titulo}
  sobrescrito="Tipo de projeto"
  descricao={p.descricao}
  abertura={p.descricao}
  voltar={{ href: '/projetos', rotulo: 'Projetos' }}
>
  <div slot="meta" class="pe" style="margin-top:1.15rem">
    <span class={`etiqueta ${p.status.toLowerCase()}`}>{p.status}</span>
    <span class="etiqueta">v{p.versao}</span>
    <span class="etiqueta">{p.skills.length} skills</span>
    {p.projeto?.duracao_tipica && <span class="etiqueta">{p.projeto.duracao_tipica}</span>}
  </div>

  {abreProjeto ? (
    <section class="secao">
      <div class="painel">
        {abreProjeto.titulo && <h2 style="margin-top:0">{abreProjeto.titulo}</h2>}
        <div class="prosa" set:html={abreProjeto.html} />
      </div>
    </section>
  ) : (
    <div class="aviso aviso--atencao">
      <p>
        <strong>A página editorial deste projeto ainda não foi escrita.</strong> O que você vê abaixo
        é derivado do plugin: a lista de skills, mas não as etapas, os riscos nem os entregáveis.
      </p>
    </div>
  )}

  {restoProjeto.length > 0 && (
    <section class="secao">
      {restoProjeto.map((s) => (
        <details class="sanfona">
          <summary>{s.titulo}</summary>
          <div class="miolo"><div class="prosa" set:html={s.html} /></div>
        </details>
      ))}
    </section>
  )}

  {(abreFundamentos || restoFundamentos.length > 0) && (
    <section class="secao">
      <span class="sobrescrito">Embasamento teórico</span>
      <h2>De onde vem o método</h2>
      {abreFundamentos && (
        <div class="painel">
          {abreFundamentos.titulo && <h3 style="margin-top:0">{abreFundamentos.titulo}</h3>}
          <div class="prosa" set:html={abreFundamentos.html} />
        </div>
      )}
      {restoFundamentos.map((s) => (
        <details class="sanfona">
          <summary>{s.titulo}</summary>
          <div class="miolo"><div class="prosa" set:html={s.html} /></div>
        </details>
      ))}
    </section>
  )}

  <section class="secao">
    <h2>O que vem no plugin</h2>

    {invocaveis.length > 0 && (
      <>
        <p>
          O Claude carrega estas sozinho quando o assunto aparece na conversa. Não é preciso digitar
          nada especial.
        </p>
        <div class="grade">
          {invocaveis.map((s) => (
            <article class="cartao">
              <h3><a href={`/skills/${s.slug}`}>{s.nome}</a></h3>
              <p>{resumo(s.descricao)}</p>
            </article>
          ))}
        </div>
      </>
    )}

    {(defundo.length > 0 || pendentes.length > 0) && (
      <details class="sanfona" style="margin-top:1.25rem">
        <summary>Detalhe técnico: skills de fundo e etapas ainda não escritas</summary>
        <div class="miolo">
          {defundo.length > 0 && (
            <>
              <h3>Carregadas por outras skills</h3>
              <p>
                Não aparecem no menu de <code>/</code>: são conhecimento de fundo que outra skill
                puxa quando precisa do conceito exato.
              </p>
              <div class="lista">
                {defundo.map((s) => (
                  <a href={`/skills/${s.slug}`}>
                    <span class="nome">{s.nome}</span>
                    <span class="oque">{resumo(s.descricao)}</span>
                  </a>
                ))}
              </div>
            </>
          )}
          {pendentes.length > 0 && (
            <>
              <h3>Etapas ainda não escritas</h3>
              <p>
                Estão fora do roteamento e <strong>não custam contexto</strong>. Existem como
                marcador do que falta.
              </p>
              <p class="pe">
                {pendentes.map((s) => <span class="etiqueta">{s.nome}</span>)}
              </p>
            </>
          )}
        </div>
      </details>
    )}
  </section>

  <section class="secao">
    <h2>Como obter</h2>
    <p>
      No Claude Code, com o marketplace já registrado, é um comando. O <code>acta-way</code> é
      pré-requisito e precisa estar instalado antes.
    </p>
    <div class="comando"><code>{p.instalacao}</code></div>
    <p>
      Se você ainda não registrou o marketplace, ou usa o Claude Desktop em vez do terminal, o
      guia de instalação cobre os três métodos.
    </p>
    <p class="acoes" style="margin-top:1.4rem">
      <a href="/comecar" class="botao botao--teal">Guia de instalação</a>
      <a href={p.repositorio} class="botao botao--linha">Ver a pasta no GitHub</a>
    </p>
  </section>
</Pagina>
