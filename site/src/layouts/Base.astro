---
import '../styles/global.css';

/* titulo: o nome da página. tituloAba: o <title> inteiro, quando a página quer outro formato
   (projeto e skill usam "Nome | ACTA"). noindex: tira a página dos buscadores mesmo que a
   política do portal mude (busca e 404 não são destino de ninguém). */
const { titulo, descricao, tituloAba, noindex = false } = Astro.props;

const SITE = 'ACTA Sistema de Conhecimento';
const DESCRICAO_PADRAO =
  'A metodologia da ACTA escrita em plugins do Claude Code: o catálogo por tipo de projeto e o guia de instalação.';

/* Política do portal: fora dos buscadores, porque o rodapé declara uso interno. Para abrir o
   portal à indexação, troque para true; busca e 404 continuam com noindex pelo prop. */
const INDEXAR_PORTAL = false;
const robots = !INDEXAR_PORTAL ? 'noindex, nofollow' : noindex ? 'noindex' : null;

const rota = Astro.url.pathname.replace(/\/$/, '') || '/';
const itens = [
  { href: '/comecar',  rotulo: 'Começar' },
  { href: '/projetos', rotulo: 'Projetos' },
  { href: '/skills',   rotulo: 'Skills' },
];
const ativo = (href) => rota === href || rota.startsWith(href + '/');
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloAba ?? `${titulo} · ${SITE}`}</title>
    {descricao && <meta name="description" content={descricao} />}
    {robots && <meta name="robots" content={robots} />}
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao ?? DESCRICAO_PADRAO} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:locale" content="pt_BR" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;600&display=swap"
    />
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>

    <header class="topo">
      <div class="envelope">
        <a href="/" class="marca"><b>ACTA</b><span>Conhecimento</span></a>
        <nav aria-label="Principal">
          {itens.map((i) => (
            <a href={i.href} aria-current={ativo(i.href) ? 'page' : undefined}>{i.rotulo}</a>
          ))}
          <a
            href="/busca"
            class="lupa"
            aria-label="Buscar no portal"
            title="Buscar no portal"
            aria-current={ativo('/busca') ? 'page' : undefined}
          >
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false">
              <circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="1.9" />
              <line x1="13.4" y1="13.4" x2="17.5" y2="17.5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
            </svg>
          </a>
        </nav>
      </div>
    </header>

    <main id="conteudo" tabindex="-1" data-pagefind-body>
      <slot />
    </main>

    <footer data-pagefind-ignore>
      <div class="envelope">
        <div class="colunas">
          <div>
            <a href="/" class="marca" style="margin-bottom:.9rem"><b>ACTA</b><span>Conhecimento</span></a>
            <p>
              A metodologia da firma escrita em plugins do Claude Code. O catálogo deste portal é
              gerado do repositório a cada publicação, então ele não descreve uma versão antiga do
              método.
            </p>
          </div>
          <nav aria-labelledby="rodape-portal">
            <h2 id="rodape-portal">Portal</h2>
            <a href="/comecar">Começar</a>
            <a href="/projetos">Projetos</a>
            <a href="/skills">Skills</a>
            <a href="/busca">Busca</a>
          </nav>
          <nav aria-labelledby="rodape-mais">
            <h2 id="rodape-mais">Também aqui</h2>
            <a href="/benchmarking">Benchmarking</a>
          </nav>
        </div>
        <div class="base">
          <span>ACTA Advisory · uso interno</span>
          <span>Gerado de <code>acta-sistema-de-conhecimento</code></span>
        </div>
      </div>
    </footer>

    <script is:inline>
      // Copiar o comando é a ação principal do portal; o botão evita a seleção manual de uma
      // linha longa que quebra em telas estreitas. Comando de exemplo não ganha botão: ele tem
      // um marcador para trocar antes de rodar, e colado como está só daria erro.
      document.querySelectorAll('.comando:not(.exemplo), .pedido').forEach((bloco) => {
        const botao = document.createElement('button');
        botao.type = 'button';
        botao.className = 'copiar';
        botao.textContent = 'copiar';
        botao.addEventListener('click', async () => {
          const texto = bloco.querySelector('code, q')?.textContent.trim() ?? '';
          try {
            await navigator.clipboard.writeText(texto);
            botao.textContent = 'copiado';
          } catch {
            botao.textContent = 'falhou';
          }
          setTimeout(() => { botao.textContent = 'copiar'; }, 1800);
        });
        bloco.appendChild(botao);
      });
    </script>
  </body>
</html>
