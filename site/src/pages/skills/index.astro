---
import Pagina from '../../layouts/Pagina.astro';
import { catalogo } from '../../lib/catalogo.js';
const { categorias } = catalogo();
const resumo = (d) => d.split('. Acionar')[0].replace(/\.$/, '') + '.';
const total = categorias.reduce((t, c) => t + c.plugins.reduce((x, p) => x + p.skills.length, 0), 0);
---

<Pagina
  titulo="Skills"
  sobrescrito="Índice"
  descricao="Todas as skills publicadas, agrupadas por plugin."
  abertura={`As ${total} skills publicadas, agrupadas pelo plugin em que vivem. Se você ainda não sabe qual instalar, comece pelo tipo de projeto: é a pergunta certa.`}
>
  {categorias.map((c) => (
    <section class="secao">
      <h2>{c.rotulo}</h2>
      {c.plugins.map((p) => (
        <>
          <h3>
            <a href={`/projetos/${p.slug}`}><code>{p.nome}</code></a>
            <span class="etiqueta" style="margin-left:.5rem">{p.skills.length}</span>
          </h3>
          <div class="lista">
            {p.skills.map((s) => (
              <a href={`/skills/${s.slug}`}>
                <span class="nome">
                  {s.nome}
                  {!s.invocavelPeloUsuario && <span class="etiqueta">de fundo</span>}
                  {(s.esqueleto || !s.roteavel) && <span class="etiqueta parcial">a escrever</span>}
                </span>
                <span class="oque">{s.descricao ? resumo(s.descricao) : ''}</span>
              </a>
            ))}
          </div>
        </>
      ))}
    </section>
  ))}

  <section class="secao">
    <h2>Como ler os rótulos</h2>
    <div class="quadro">
      <table>
        <tbody>
          <tr>
            <th style="width:10rem"><span class="etiqueta">de fundo</span></th>
            <td>
              Não aparece no menu de <code>/</code>. É conhecimento que outra skill carrega quando
              precisa do conceito exato; você não a invoca diretamente.
            </td>
          </tr>
          <tr>
            <th><span class="etiqueta parcial">a escrever</span></th>
            <td>
              A etapa está mapeada mas a metodologia ainda não foi escrita. Está fora do roteamento e
              <strong>não custa contexto</strong>: existe como marcador do que falta.
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</Pagina>
