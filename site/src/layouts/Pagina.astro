---
/* Página interna: faixa de título mais o corpo. Existe para que as páginas internas não
   repitam a mesma marcação de cabeçalho. tituloAba e noindex passam direto para a Base. */
import Base from './Base.astro';
const { titulo, descricao, sobrescrito, abertura, voltar, tituloAba, noindex } = Astro.props;
---
<Base titulo={titulo} descricao={descricao} tituloAba={tituloAba} noindex={noindex}>
  <div class="capa">
    <div class="envelope">
      {voltar && <p class="rastro"><a href={voltar.href}>← {voltar.rotulo}</a></p>}
      {sobrescrito && <span class="sobrescrito">{sobrescrito}</span>}
      <h1>{titulo}</h1>
      {abertura && <p class="abertura">{abertura}</p>}
      <slot name="meta" />
    </div>
  </div>

  <div class="envelope conteudo">
    <slot />
  </div>
</Base>
