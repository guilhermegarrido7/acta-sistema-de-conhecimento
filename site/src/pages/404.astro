---
import Pagina from '../layouts/Pagina.astro';
---

<Pagina
  titulo="Esta página não existe"
  sobrescrito="Erro 404"
  noindex
  abertura="O endereço pode estar errado, ou o conteúdo pode ter mudado de lugar: o catálogo é gerado do repositório, então uma skill renomeada muda de endereço junto."
>
  <section class="secao">
    <h2>Procure pelo que você queria abrir</h2>
    <form action="/busca" method="get" role="search" class="busca-rapida">
      <label for="busca-404" class="visualmente-oculto">Buscar no portal</label>
      <input id="busca-404" name="q" type="search" placeholder="Nome da skill, do projeto ou um termo" autocomplete="off" />
      <button type="submit">Buscar</button>
    </form>
    <script is:inline>
      // O endereço que falhou costuma ser uma skill renomeada: o último trecho dele vira o termo
      // sugerido na caixa ("/skills/ciclo-ptp" sugere "ciclo ptp").
      (() => {
        const campo = document.getElementById('busca-404');
        const partes = location.pathname.split('/').filter((s) => s && !/^(index|404)(\.html)?$/i.test(s));
        const ultimo = decodeURIComponent(partes.pop() || '');
        if (campo && ultimo) campo.value = ultimo.replace(/[-_]+/g, ' ');
      })();
    </script>
  </section>

  <section class="secao">
    <h2>Por onde seguir</h2>
    <div class="grade">
      <article class="cartao">
        <h3><a href="/projetos">Projetos</a></h3>
        <p>O catálogo por tipo de engajamento. É a porta certa quando você sabe o trabalho, não a ferramenta.</p>
      </article>
      <article class="cartao">
        <h3><a href="/skills">Skills</a></h3>
        <p>Todas as skills, agrupadas pelo plugin em que vivem.</p>
      </article>
      <article class="cartao">
        <h3><a href="/busca">Busca</a></h3>
        <p>Procura no texto de todas as páginas do portal.</p>
      </article>
      <article class="cartao">
        <h3><a href="/comecar">Começar</a></h3>
        <p>Instalação, pré-requisitos e o que fazer quando não funciona.</p>
      </article>
    </div>
  </section>
</Pagina>
