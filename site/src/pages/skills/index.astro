---
import Pagina from '../../layouts/Pagina.astro';
import { catalogo } from '../../lib/catalogo.js';
import { gruposDeTerceiros } from '../../lib/terceiros.js';
const { categorias } = catalogo();
const totalDaCasa = categorias.reduce((t, c) => t + c.plugins.reduce((x, p) => x + p.skills.length, 0), 0);
---

<Pagina
  titulo="Skills"
  sobrescrito="Catálogo"
  descricao="Todas as skills da ACTA e as de uso geral, num só lugar."
  abertura={`As ${totalDaCasa} skills da metodologia da casa, mais as de uso geral que valem para qualquer projeto. Se você não sabe qual instalar, comece por tipo de projeto: é a pergunta mais fácil de responder.`}
>
  <p class="acoes" style="margin:1.25rem 0 0">
    <a href="/projetos" class="botao botao--linha">Prefiro escolher pelo tipo de projeto →</a>
  </p>

  <section class="secao" id="metodologia">
    <h2>Metodologia da ACTA</h2>

    {/* O filtro só aparece com JavaScript: sem ele, o campo seria uma caixa que não faz nada. */}
    <div class="filtro" hidden>
      <label for="filtro-skills">Filtrar as {totalDaCasa} skills da casa</label>
      <input
        id="filtro-skills"
        type="search"
        autocomplete="off"
        placeholder="Ex.: data room, folha, ROIC, amostragem"
        aria-describedby="filtro-resultado"
      />
      <p class="nota" id="filtro-resultado" aria-live="polite"></p>
    </div>

    {categorias.map((c, i) => {
      const n = c.plugins.reduce((t, p) => t + p.skills.length, 0);
      return (
      <details class="sanfona" open={i === 0}>
        <summary><span>{c.rotulo}</span><span class="etiqueta contador">{n} {n === 1 ? 'skill' : 'skills'}</span></summary>
        <div class="miolo">
          {c.plugins.map((p) => (
            <div class="grupo-plugin">
              <h3>
                <a href={p.url}>{p.titulo}</a>
                <span class="etiqueta" style="margin-left:.5rem">{p.skills.length}</span>
              </h3>
              <div class="grade">
                {p.skills.map((s) => (
                  <article class="cartao">
                    <h4>
                      <a href={s.url}>{s.titulo}</a>
                    </h4>
                    <p>{s.descricao ? s.oQueFaz || s.descricao : 'Etapa mapeada, metodologia ainda não escrita.'}</p>
                    <div class="pe">
                      <code>{s.nome}</code>
                      {s.manual && <span class="etiqueta">manual</span>}
                      {!s.invocavelPeloUsuario && <span class="etiqueta">de fundo</span>}
                      {s.esqueleto && <span class="etiqueta parcial">a escrever</span>}
                    </div>
                  </article>
                ))}
              </div>
            </div>
          ))}
        </div>
      </details>
      );
    })}
  </section>

  <script is:inline>
    // Filtro do índice: procura em título, descrição e identificador de cada skill, sem acento e
    // sem diferença de caixa. Todos os termos digitados têm de aparecer. As áreas com resultado
    // abrem; as sem resultado somem. Campo vazio devolve a página ao estado inicial.
    (() => {
      const caixa = document.querySelector('.filtro');
      const secao = document.getElementById('metodologia');
      if (!caixa || !secao) return;
      caixa.hidden = false;
      const campo = caixa.querySelector('input');
      const saida = document.getElementById('filtro-resultado');
      const sanfonas = [...secao.querySelectorAll('details.sanfona')];
      const inicial = sanfonas.map((d) => d.open);
      const grupos = [...secao.querySelectorAll('.grupo-plugin')];
      const norm = (t) => t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
      const cartoes = [...secao.querySelectorAll('.cartao')].map((c) => ({ c, texto: norm(c.textContent) }));
      let espera;

      const aplicar = () => {
        const termos = norm(campo.value).split(/\s+/).filter(Boolean);
        if (termos.length === 0) {
          cartoes.forEach(({ c }) => { c.hidden = false; });
          grupos.forEach((g) => { g.hidden = false; });
          sanfonas.forEach((d, i) => { d.hidden = false; d.open = inicial[i]; });
          saida.textContent = '';
          return;
        }
        let total = 0;
        cartoes.forEach(({ c, texto }) => {
          const casa = termos.every((t) => texto.includes(t));
          c.hidden = !casa;
          if (casa) total += 1;
        });
        grupos.forEach((g) => { g.hidden = !g.querySelector('.cartao:not([hidden])'); });
        sanfonas.forEach((d) => {
          const tem = Boolean(d.querySelector('.cartao:not([hidden])'));
          d.hidden = !tem;
          d.open = tem;
        });
        if (total === 0) {
          saida.innerHTML = 'Nenhuma skill com esses termos. <a href="/busca?q=' +
            encodeURIComponent(campo.value.trim()) + '">Procurar no portal inteiro</a>.';
        } else {
          saida.textContent = total === 1 ? '1 skill encontrada.' : total + ' skills encontradas.';
        }
      };

      campo.addEventListener('input', () => {
        clearTimeout(espera);
        espera = setTimeout(aplicar, 120);
      });
    })();
  </script>

  <section class="secao">
    <h2>De uso geral</h2>
    <p>
      Nem tudo que ajuda no trabalho é metodologia da ACTA. Estas valem em qualquer engajamento e não
      pertencem a um plugin de projeto.
    </p>
    <div class="aviso aviso--atencao">
      <p>
        <strong>Não vêm do nosso marketplace.</strong> Instalam por outros caminhos, são mantidas por
        terceiros e podem mudar sem aviso. Nenhuma delas conhece o método da casa, e nenhuma dispensa
        as regras de confidencialidade quando o arquivo é de cliente.
      </p>
    </div>
    {gruposDeTerceiros.map((g) => (
      <>
        <h3>{g.grupo}</h3>
        <div class="grade">
          {g.itens.map((it) => (
            <article class="cartao">
              <h4><a href={`/skills/uso-geral/${it.slug}`}>{it.nome}</a></h4>
              <p>{it.resumo}</p>
            </article>
          ))}
        </div>
      </>
    ))}
  </section>

  <section class="secao">
    <h2>Como ler os rótulos</h2>
    <div class="quadro">
      <table>
        <tbody>
          <tr>
            <th style="width:10rem"><span class="etiqueta">manual</span></th>
            <td>
              O Claude não a carrega sozinho: a descrição fica fora do contexto e ela
              <strong>não custa contexto</strong>. Só roda quando você digita <code>/</code> e o
              nome dela.
            </td>
          </tr>
          <tr>
            <th><span class="etiqueta">de fundo</span></th>
            <td>
              Não aparece no menu de <code>/</code>, mas a descrição continua no contexto: o Claude
              a carrega sozinho quando o assunto aparece, e outras skills a puxam quando precisam do
              conceito exato.
            </td>
          </tr>
          <tr>
            <th><span class="etiqueta parcial">a escrever</span></th>
            <td>
              A etapa está mapeada mas a metodologia ainda não foi escrita: a skill existe como
              marcador do que falta.
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</Pagina>
